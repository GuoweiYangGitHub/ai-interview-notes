# 阿里云百炼 Token Plan（OpenAI 兼容）
# API Key 以 sk-sp- 开头，与普通百炼 sk- 密钥、Base URL 不可混用
BAILIAN_TOKEN_PLAN_API_KEY=
CHAT_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.8-flash

# Coze 中国区（exampleAgentFramework/coze）
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_USER_ID=user_12345

# Dify（exampleAgentFramework/dify）
# 本地默认；云端改为 https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_BASE_URL=http://localhost/v1
DIFY_USER_ID=demo_user

# Text-to-SQL 用同一套百炼 Chat 模型。演示库是本地 sqlite。

# Tavily MCP / ChatBI 新闻（https://app.tavily.com/home）
TAVILY_API_KEY=

# Tushare（exampleMcpTools/Tushare 与 ChatBI 灌库，https://tushare.pro）
TUSHARE_TOKEN=

# FAISS / 多模态 RAG（06.Faiss使用、07.多模态RAG知识库）
# Token Plan 不含 embedding。要走百炼向量化再配普通百炼 Key（sk- 开头，不要用 sk-sp-）
# DASHSCOPE_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
