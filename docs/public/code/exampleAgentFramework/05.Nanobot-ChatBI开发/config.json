{
  "agents": {
    "defaults": {
      "workspace": ".",
      "model": "qwen3.8-flash",
      "provider": "custom",
      "max_tokens": 8192,
      "context_window_tokens": 65536,
      "temperature": 0.1,
      "max_tool_iterations": 50,
      "max_tool_result_chars": 16000,
      "timezone": "Asia/Shanghai"
    }
  },
  "providers": {
    "custom": {
